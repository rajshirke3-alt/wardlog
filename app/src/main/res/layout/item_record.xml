<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:foreground="?attr/selectableItemBackground"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:clickable="true"
    android:focusable="true">

    <TextView android:id="@+id/colBed" style="@style/CellBed" />
    <TextView android:id="@+id/colName" style="@style/CellName" />
    <TextView android:id="@+id/colConsultant" style="@style/CellConsultant" />
    <TextView android:id="@+id/colDetails" style="@style/CellDetails" />
</LinearLayout>
